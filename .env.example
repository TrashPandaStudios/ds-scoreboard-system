# Optional Cloudflare Tunnel configuration for the Public Read-Only Live Spectator Portal.
# Copy this file to `.env` (never commit `.env` to git) and fill in your tunnel token.
#
# In Cloudflare Zero Trust Dashboard -> Networks -> Tunnels -> Your Tunnel -> Public Hostnames:
#   Service Type: HTTP
#   URL:          localhost:8081
#
# Traffic arriving on port 8081 (or via Cloudflare Tunnel headers) is strictly locked down to
# read-only spectator views (live matches, live scores/clocks, set breakdowns, results, and schedule).

CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_SITE_URL=
